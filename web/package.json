    "@babel/traverse": "^7.23.2",
    "@types/react": "19.2.18",
    "async": "^2.6.4",
    "body-parser": "^1.20.3",
    "brace-expansion": "^1.1.16",
    "braces": "^3.0.3",
    "browserslist": "^4.28.7",
    "express": "^4.20.0",
    "form-data": "^3.0.5",
    "follow-redirects": "^1.16.0",
    "flatted": "^3.4.2",
    "http-proxy-middleware": "^2.0.10",
    "js-yaml": "^4.3.1",
    "json5": "^2.2.2",
    "loader-utils": "^1.4.2",
    "lodash": "^4.18.0",
    "minimatch": "^3.1.3",
    "minimist": "^1.2.6",
    "nanoid": "^3.3.12",
    "node-forge": "^1.4.0",
    "picomatch": "^2.3.2",
    "postcss": "^8.5.23",
    "protocol-buffers-schema": "^3.6.1",
    "qs": "^6.14.2",
    "serialize-javascript": "^7.0.5",
    "tough-cookie": "^4.1.3",
    "uuid": "^11.1.1",
    "webpack": "^5.104.1",
    "ws": "^8.21.0",
    "websocket-driver": "^0.7.5",
    "yaml": "^1.10.3"
  },
  "babel": {
    "presets": [
      "@babel/preset-env",
      "@babel/preset-react",
      "@babel/preset-typescript"
    ],
    "plugins": [
      [
        "@babel/plugin-transform-runtime",
        {
          "regenerator": true
        }
      ]
    ]
  },
  "eslintConfig": {
    "env": {
      "browser": true,
      "node": true
    },
    "globals": {
      "fetch": true
    },
    "root": true,
    "parser": "@typescript-eslint/parser",
    "parserOptions": {
      "ecmaVersion": 2019,
      "sourceType": "module",
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "plugins": [
      "@typescript-eslint",
      "react",
      "react-hooks",
      "import"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/eslint-recommended",
      "plugin:@typescript-eslint/recommended",
      "plugin:react/recommended",
      "plugin:react-hooks/recommended"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": [
        "warn"
      ],
      "@typescript-eslint/ban-ts-comment": "warn",
      "react/prop-types": "warn",
      "import/no-unresolved": "warn",
      "react-hooks/rules-of-hooks": "error",
      "react-hooks/exhaustive-deps": "warn"
    },
    "settings": {
      "react": {
        "pragma": "React",
        "version": "19.2.8"
      },
      "import/parsers": {
        "@typescript-eslint/parser": [
          ".ts",
          ".tsx"
        ]
      },
      "import/resolver": {
        "node": {
          "extensions": [
            ".ts",
            ".tsx"
          ]
        },
        "typescript": {
          "extensions": [
            ".ts",
            ".tsx",
            ".js",
            ".jsx"
          ],
          "alwaysTryTypes": true
        }
      }
    }
  },
  "eslintIgnore": [
    "node_modules",
    "dist",
    "test"
  ]
}
